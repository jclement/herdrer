# deploy/Caddyfile.template — the tailnet edge for herdrer.
#
# This is a TEMPLATE. scripts/provision.sh substitutes __DOMAIN__, __UPSTREAM__
# and __BIND__ and writes the result to /etc/caddy/Caddyfile. Do not edit the
# rendered file on the box; edit this and re-run provision.sh, or your change
# is one `provision.sh` away from being overwritten.
#
# What it does:
#   * listens ONLY on __BIND__ — this box's Tailscale addresses, never the
#     public NIC. herdrer forks shells on a box holding sensitive data, so it
#     has no business being reachable from the internet, and a bind is the one
#     control that still holds when a firewall rule is loosened by mistake.
#   * terminates TLS with a real Let's Encrypt certificate for the *.ts.net
#     name, fetched from tailscaled rather than obtained by Caddy. Tailscale
#     owns the ts.net zone and validates over DNS-01, so this needs no inbound
#     80/443 and no public DNS record. Renewal is tailscaled's job, not Caddy's.
#   * reverse-proxies every request to herdrer on __UPSTREAM__
#
# Requires TS_PERMIT_CERT_UID=caddy in /etc/default/tailscaled. Fetching a cert
# over the tailscaled LocalAPI is root-only until that names the non-root user
# allowed to ask, and the failure is quiet: Caddy starts normally and then
# serves no certificate at all.
#
# Why there is a proxy at all: herdrer forks shells. The process that forks
# shells should not be the one holding CAP_NET_BIND_SERVICE on a public
# interface, and should not be the one parsing ACME. Caddy holds both; herdrer
# holds a loopback socket and nothing else.
#
# Assumes: Caddy >= 2.7 from the official Cloudsmith apt repo, running as the
# system `caddy` user, with /var/log/caddy writable by it (the .deb creates it).
# `tls.get_certificate.tailscale` ships in the standard Caddy build.
#
# Rendered to /etc/caddy/Caddyfile by scripts/provision.sh.
# After editing:  sudo caddy validate --config /etc/caddy/Caddyfile
#                 sudo systemctl reload caddy
{
	# Bind every listener to the tailnet only. Caddy resolves these once at
	# startup, so caddy.service must order itself after tailscaled and retry on
	# failure — provision.sh installs the drop-in that does both. Without this
	# bind Caddy would answer on the public NIC the moment a firewall rule
	# changed, which is exactly the mistake the bind exists to survive.
	default_bind __BIND__

	# Uncomment with a real address to receive Let's Encrypt expiry warnings.
	# Caddy renews automatically, so this is a safety net, not a requirement.
	# email you@example.com

	servers {
		timeouts {
			# The only timeout that should ever fire here. A client that opens a
			# connection and never finishes its request headers is not a terminal
			# session, it is a scanner.
			read_header 30s

			# Everything else is deliberately unlimited. herdrer's agent long-poll
			# holds a request open for up to HERDRER_LONGPOLL_MAX_SECONDS (300s by
			# default) and its terminal WebSocket stays open for hours. Any finite
			# write timeout cuts both off mid-flight, and the symptom — a terminal
			# that dies after exactly N seconds, or an agent that sees a hang-up
			# instead of {"status":"open"} — is the single most common way this
			# deployment breaks. Do not "tidy" these into real numbers.
			read_body 0
			write 0

			# `idle` applies between keep-alive requests, not to an in-flight one,
			# so it cannot cut a long-poll. Kept comfortably above the 300s
			# long-poll ceiling anyway so a polling agent's connection is never
			# reaped in the gap between two polls.
			idle 15m
		}
	}
}

__DOMAIN__ {
	# The certificate comes from tailscaled, not from Caddy's ACME client. This
	# name resolves and is reachable only inside the tailnet, so neither HTTP-01
	# nor TLS-ALPN could ever be validated from outside; Tailscale holds the
	# ts.net zone, does DNS-01 on our behalf, and owns renewal. Removing this
	# block does not fall back to something that works — Caddy would start
	# requesting a public certificate it can never be issued.
	tls {
		get_certificate tailscale
	}

	log {
		output file /var/log/caddy/herdrer.access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format json
	}

	# Caddy never compresses a hijacked connection, so the WebSocket is
	# untouched; flush_interval below keeps streamed and long-polled responses
	# out of the encoder's buffer.
	encode zstd gzip

	reverse_proxy __UPSTREAM__ {
		# `caddy validate` calls these three "unnecessary" because it only checks
		# that the header reaches the upstream. They are not: verified against
		# caddy 2.11, `header_up X-Forwarded-For {remote_host}` *replaces* an
		# inbound "X-Forwarded-For: 9.9.9.9" with the address Caddy observed,
		# where the default would have appended to the attacker's value.
		#
		# Set, not appended, on purpose. This is the edge: the only trustworthy
		# client address is the one Caddy itself observed. Caddy's default is to
		# append to an inbound X-Forwarded-For, which would let a client seed the
		# chain with a forged hop that herdrer's audit log would then believe.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# -1 disables response buffering entirely: bytes reach the client as they
		# arrive. Required for the terminal stream and for any SSE.
		flush_interval -1

		transport http {
			# Fast failure when herdrer is down or restarting — this is a loopback
			# dial, so 5s is generous.
			dial_timeout 5s

			# 0 = no timeout, for the same reason as the server block above. These
			# govern the Caddy->herdrer leg; a finite value here breaks long-polls
			# even though the client-facing timeouts are unlimited.
			read_timeout 0
			write_timeout 0
		}
	}
}
