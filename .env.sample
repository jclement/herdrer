# herdrer configuration — every key, no values.
# Copy to .env for local development; on the server these live in the systemd unit.

# --- identity / origin -------------------------------------------------------
# The public hostname. WebAuthn binds credentials to this; changing it invalidates
# every registered passkey.
HERDRER_DOMAIN=
# Full origin the browser will use. Must match HERDRER_DOMAIN and the scheme.
HERDRER_ORIGIN=

# --- listeners ---------------------------------------------------------------
# HTTPS listener. autocert answers ACME TLS-ALPN-01 here.
HERDRER_ADDR=
# "file" (HERDRER_TLS_CERT/KEY) or "off" (plain HTTP, for a terminating proxy
# on loopback — the deployed shape, where Caddy holds the certificate).
# "autocert" is accepted by the config but not wired: binding :443 would need
# CAP_NET_BIND_SERVICE on the process that forks shells.
HERDRER_TLS_MODE=
HERDRER_TLS_CERT=
HERDRER_TLS_KEY=
# Contact address for the ACME account.
HERDRER_ACME_EMAIL=

# --- state -------------------------------------------------------------------
# Directory holding herdrer.db, the ACME cache, and the VAPID keypair. 0700.
HERDRER_STATE_DIR=

# --- auth --------------------------------------------------------------------
# Session lifetime in days, refreshed on activity.
HERDRER_SESSION_TTL_DAYS=
# Minutes the first-run enrollment window stays open after the code is printed.
HERDRER_ENROLL_TTL_MINUTES=
# NEVER true in production. Skips WebAuthn and auto-logs-in a dev user.
# Refuses to start if set true while a non-loopback listener is configured.
SUPPRESS_AUTH=

# --- herdr -------------------------------------------------------------------
# Directory containing herdr.sock / sessions/<name>/herdr.sock.
# Empty means autodetect under the run-as user's XDG config.
HERDRER_HERDR_CONFIG_DIR=
# Set false to build a review-only deployment with no PTY and no shell reachable.
HERDRER_TERMINAL_ENABLED=

# --- notifications -----------------------------------------------------------
# Generated into the state dir on first run if absent; these override.
HERDRER_VAPID_PUBLIC_KEY=
HERDRER_VAPID_PRIVATE_KEY=
HERDRER_VAPID_SUBJECT=
# Optional outbound mirror for pushes, e.g. an ntfy topic URL.
HERDRER_NTFY_URL=

# --- limits ------------------------------------------------------------------
HERDRER_LONGPOLL_MAX_SECONDS=
HERDRER_MAX_OPEN_ITEMS=
HERDRER_DEFAULT_EXPIRY_HOURS=
HERDRER_MAX_EXPIRY_HOURS=
